{
  "experiment_name": "baseline_v1",
  "description": "проверка pipeline",
  "created_at": "2026-08-20",

  "raw_datasets": {
    "split": "predefined",
    "train": "train.csv",
    "test": "test.csv"
  },

  "cleaned_datasets": {
    "split": "predefined",
    "train": "train.csv",
