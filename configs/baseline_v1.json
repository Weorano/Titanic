      "age",
      "fare",
      "family_size",
      "female_count",
      "male_count",
      "child_count",
      "ticket_group_size",
      "same_importance_relatives",
      "high_importance_relatives"
    ],
    "categorical_features": [
      "sex",
      "family_type",
      "embarked"
    ],
    "ordinal_features": [
      "category_significance"
    ],
    "binary_features": []
  },

  "cross_validation": {
    "strategy": "StratifiedKFold",
    "n_splits": 5,
    "shuffle": true,
    "random_state": 42
  },

  "models": [
    "logistic"
  ]
